{
    "name": "aaix/laravel-islands-filemanager",
    "description": "A Finder-like file manager for Laravel Islands: folders, list and thumbnail views, notes, comments, Quick Look and full-text search.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "aaix/laravel-islands": "^1.0",
        "aaix/laravel-islands-datagrid": "^1.0",
        "aaix/laravel-islands-search": "^1.0",
        "ext-zip": "*",
        "illuminate/support": "^12.0|^13.0",
        "intervention/image": "^4.0",
        "spatie/temporary-directory": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Aaix\\LaravelIslandsFilemanager\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aaix\\LaravelIslandsFilemanager\\FileManagerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Aaix\\LaravelIslandsFilemanager\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
